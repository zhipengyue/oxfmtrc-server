PORT=3005
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=oxfmtrc
JWT_SECRET=
PROJECT_SECRET_MASTER_KEY=
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# 在线项目代理：开发环境默认允许本机/内网目标，生产环境默认禁止。
RUNTIME_PROXY_ALLOW_PRIVATE_TARGETS=false
RUNTIME_PROXY_MAX_RESPONSE_MB=20

# MinIO（本地 Docker 默认）
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=visual-assets
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000
MINIO_USE_PUBLIC_URL=true
MINIO_PRESIGNED_EXPIRES=3600
MINIO_MAX_UPLOAD_BYTES=104857600
# 逗号分隔；匹配手机号的账号登录后拥有平台管理员权限。
PLATFORM_ADMIN_PHONES=
